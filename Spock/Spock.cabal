name:                Spock
version:             0.18.0.0
synopsis:            Another Haskell web framework for rapid development
description:         This toolbox provides everything you need to get a quick start into web hacking with haskell:
                     .
                     * fast routing
                     .
                     * middleware
                     .
                     * json
                     .
                     * sessions
                     .
                     * cookies
                     .
                     * database helper
                     .
                     * csrf-protection
                     .
                     A tutorial is available at <http://www.spock.li/tutorial/ spock.li>
Homepage:            https://www.spock.li
Bug-reports:         https://github.com/agrafix/Spock/issues
license:             BSD3
license-file:        LICENSE
author:              Alexander Thiemann <mail@athiemann.net>
maintainer:          Alexander Thiemann <mail@athiemann.net>
copyright:           (c) 2013 - 2021 Alexander Thiemann
category:            Web
build-type:          Simple
cabal-version:       2.0
tested-with:         GHC==9.14.1

extra-source-files:
    README.md
    benchmarks/README.md

library
  hs-source-dirs:      src
  exposed-modules:
                  Web.Spock,
                  Web.Spock.Config,
                  Web.Spock.SessionActions,
                  Web.Spock.SessionActions.Server,
                  Web.Spock.Internal.SessionVault,
                  Web.Spock.Internal.SessionManager
  other-modules:
                Web.Spock.Internal.Monad,
                Web.Spock.Internal.ClientSession,
                Web.Spock.Internal.SessionCommon,
                Web.Spock.Internal.Types
  build-depends:
                       Spock-core >= 0.16.1.0,
                       base >= 4 && < 5,
                       base64-bytestring >=1.0,
                       bytestring >=0.10,
                       containers >=0.5,
                       cookie >=0.4,
                       entropy >= 0.4.1.11 && < 0.5,
                       focus >=0.1,
                       hashable >=1.2,
                       hvect >=0.3,
                       http-types >=0.8,
                       list-t >=0.4,
                       monad-control >=1.0,
                       mtl >=2.1,
                       reroute >=0.9.0.0,
                       resource-pool >=0.4 && <0.6,
                       resourcet >= 1.2.2,
                       stm >=2.4,
                       stm-containers >= 1.1.0.2,
                       text >= 0.11.3.1,
                       time >=1.4,
                       transformers >=0.3,
                       transformers-base >=0.4,
                       unordered-containers >=0.2,
                       vault >=0.3,
                       wai >=3.0
  ghc-options: -Wall -fno-warn-orphans
  default-language:    Haskell2010

test-suite spocktests
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test, example
  main-is:             Spec.hs
  other-modules:
                FAQ,
                Monads,
                Web.Spock.FAQSpec,
                Web.Spock.MonadTypesSpec,
                Web.Spock.Internal.SessionVaultSpec,
                Web.Spock.Internal.SessionManagerSpec,
                Web.Spock.Internal.SessionLifecycleSpec,
                Web.Spock.SessionModeSpec,
                Web.Spock.SessionCookieSpec,
                Web.Spock.SafeSpec,
                Web.Spock.CsrfSpec,
                Web.Spock.TestUtils
  build-depends:
                       base,
                       async >= 2.2,
                       bytestring,
                       hspec >= 2.0,
                       hspec-wai >= 0.6,
                       http-api-data,
                       http-types,
                       mtl,
                       regex-tdfa >= 1.3 && < 1.4,
                       Spock,
                       Spock-core,
                       stm,
                       transformers,
                       text,
                       time,
                       unordered-containers,
                       vault,
                       wai,
                       wai-extra

  ghc-options: -Wall -fno-warn-orphans
  default-language:    Haskell2010

executable spock-monads-example
  hs-source-dirs: example
  main-is: Main.hs
  other-modules: Monads
  build-depends: base, mtl, Spock, Spock-core, text, transformers
  default-language: Haskell2010
  ghc-options: -Wall -threaded

executable spock-faq-example
  hs-source-dirs: example
  main-is: FAQMain.hs
  other-modules: FAQ
  build-depends: base, http-api-data, http-types, regex-tdfa >= 1.3 && < 1.4, Spock, text
  default-language: Haskell2010
  ghc-options: -Wall -threaded

source-repository head
  type:     git
  location: https://github.com/agrafix/Spock

benchmark session-soak
  type: exitcode-stdio-1.0
  hs-source-dirs: benchmarks
  main-is: SessionSoak.hs
  build-depends: base, bytestring, directory, Spock, Spock-core, transformers, wai, wai-extra
  ghc-options: -Wall -O2 -threaded -rtsopts -with-rtsopts=-T
  default-language: Haskell2010
