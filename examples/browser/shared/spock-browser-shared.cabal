cabal-version: 2.0
name: spock-browser-shared
version: 0.1.0.0
build-type: Simple
license: BSD3
synopsis: Shared API for the Spock browser example

library
  hs-source-dirs: src
  exposed-modules: Shared
  build-depends: base, aeson, Spock-api >= 0.17 && < 0.18, text
  default-language: Haskell2010
  ghc-options: -Wall
