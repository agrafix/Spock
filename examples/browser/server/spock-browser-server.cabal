cabal-version: 2.0
name: spock-browser-server
version: 0.1.0.0
build-type: Simple
license: BSD3
synopsis: Native server for the shared Haskell browser example

library
  hs-source-dirs: src
  exposed-modules: BrowserServer
  build-depends: base, bytestring, directory, filepath, http-types, Spock,
                 Spock-api-server, spock-browser-shared, text, wai
  default-language: Haskell2010
  ghc-options: -Wall

executable spock-browser-server
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base, spock-browser-server, warp
  default-language: Haskell2010
  ghc-options: -Wall -threaded

test-suite browser-server-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends: base, aeson, bytestring, cookie, hspec, http-types,
                 spock-browser-server, spock-browser-shared, text, wai, wai-extra
  default-language: Haskell2010
  ghc-options: -Wall -threaded
