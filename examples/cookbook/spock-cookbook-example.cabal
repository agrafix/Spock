cabal-version: 2.0
name: spock-cookbook-example
version: 0.1.0.0
build-type: Simple
license: BSD3
synopsis: Tested request, middleware, upload and logging recipes for Spock
extra-source-files: README.md

library
  hs-source-dirs: src
  exposed-modules: Cookbook, Hello
  build-depends: base, aeson, bytestring, http-types, Spock, Spock-core, text,
                 transformers, unordered-containers, wai, wai-cors
  default-language: Haskell2010
  ghc-options: -Wall

executable spock-cookbook-example
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base, aeson, bytestring, spock-cookbook-example, warp
  default-language: Haskell2010
  ghc-options: -Wall -threaded

test-suite cookbook-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules: CookbookSpec, HelloSpec
  build-depends: base, aeson, bytestring, hspec, hspec-wai, http-types, Spock,
                 Spock-core, spock-cookbook-example, text, wai, wai-extra
  default-language: Haskell2010
  ghc-options: -Wall -threaded
